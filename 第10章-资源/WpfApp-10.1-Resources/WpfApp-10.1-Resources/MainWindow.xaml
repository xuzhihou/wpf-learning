<Window x:Class="WpfApp_10._1_Resources.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_10._1_Resources"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
		<ImageBrush x:Key="MyImageBrush" TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute" ImageSource="/img/哈士奇.png" Opacity="0.3"/>
    </Window.Resources>
    <StackPanel>
        <Button Background="{StaticResource MyImageBrush}" Content="Button with ImageBrush"/>
        <Button Content="A normal button" Click="Button_Click"/>
        <Button Background="{DynamicResource MyImageBrush}" Content="Another MyImageBrush button"/>
    </StackPanel>
</Window>
